{
  "name": "laryko",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "cap:sync": "node scripts/sync-version.mjs && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "sync:version": "node scripts/sync-version.mjs",
    "sync:check": "node scripts/sync-version.mjs --check",
    "audit": "pnpm audit --audit-level=critical",
    "security:check": "pnpm audit --audit-level=critical && tsc --noEmit && node scripts/sync-version.mjs --check",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/network": "8.0.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-updater": "2.14.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "^1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0"
  }
}
